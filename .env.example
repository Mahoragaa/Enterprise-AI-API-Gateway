# ─── Enterprise AI API Gateway — Environment Variables ────────────────────────
#
# Copy this file to .env and fill in real values.
# The .env file is git-ignored — NEVER commit real secrets.
#
# Usage: docker compose automatically reads .env from the project root.
# ─────────────────────────────────────────────────────────────────────────────

# LiteLLM master key — used for admin API calls (/key/generate, /team/new, etc.)
# Must be at least 8 characters and start with "sk-"
LITELLM_MASTER_KEY=sk-master-key-1234

# Redis connection (used by LiteLLM for distributed rate limiting + health state)
REDIS_HOST=redis
REDIS_PORT=6379

# OpenAI API key — the mock providers do NOT validate this, but LiteLLM requires
# it to be set because the model is prefixed with "openai/" in litellm_config.yaml.
# For real LLM calls, replace with your actual key: sk-...
OPENAI_API_KEY=sk-fake-not-used

# ─── Optional: Real LLM fallback (Tier 5 stretch goal) ───────────────────────
# Uncomment to add a real OpenAI/Anthropic endpoint as a tertiary fallback.
# REAL_OPENAI_API_KEY=sk-your-real-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Optional: Grafana admin credentials (added in Tier 3) ───────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=gateway123
